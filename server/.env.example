PORT= port number 

NODE_ENV= (development or production) the type

DATABASE_URL= POSTGRESQL Db url

api_key= api key that contains alphanumerals 

JWT_SECRET= Alphanumeric JWT Secret of Project

JWT_EXPIRES_IN= duration of JWT Token Expiry(Preferably in days)

OPENROUTER_API_KEY = API Key Generated After Creating account on OpenRouter Website

CLOUDINARY_CLOUD_NAME=your_cloud_name

CLOUDINARY_API_KEY=your_api_key

CLOUDINARY_API_SECRET=your_api_secret

OPENROUTER_EMBEDDING_MODEL=openai/text-embedding-3-small